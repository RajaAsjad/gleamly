# Gleamly — Apache config (XAMPP / production)
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /gleamly/

  # Force trailing slash off for directories except services index handled by Apache
  ErrorDocument 404 /gleamly/404.php

  # Protect sensitive paths
  RewriteRule ^data/ - [F,L]
  RewriteRule ^includes/ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# Deny access to JSON data via direct request as backup
<FilesMatch "\.(json|log|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
